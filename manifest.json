{
  "manifest_version": 3,
  "name": "KP → Gembird stanje",
  "short_name": "Gembird stanje",
  "version": "1.3",
  "description": "Prikazuje stanje i cenu sa gembird.rs direktno na KupujemProdajem oglasu, po EAN kodu.",
  "permissions": [],
  "host_permissions": [
    "https://www.gembird.rs/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kupujemprodajem.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Gembird stanje"
  }
}